<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications. "development" is what Xcode needs for debug runs;
	     when archiving for TestFlight / the App Store, Xcode's automatic
	     signing swaps it for "production" from the distribution profile. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
