# Copy to android/key.properties and fill in. That file is gitignored —
# never commit it, and never commit the .jks it points at.
#
# Generate the upload keystore:
#   keytool -genkey -v -keystore ~/clozr-upload.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# storeFile is resolved relative to android/app/, so an absolute path is safest.
storeFile=/absolute/path/to/clozr-upload.jks
storePassword=
keyAlias=upload
keyPassword=
